%% Variante que imprimeix una etiqueta en negreta abans del valor.
\def\pxPRINTF~#1.#2[#3]{ \textbf{#1 . #2 [ #3 ] :} \pxPRP_get_item:nnn {#1}{#2}{#3} } %TODO DEPRECATE unnecessary function
\def\pxPRINTlst#1.#2(#3){ \pxPRP_list_use:nnn {#1}{#2}{#3}}%TODO pxSYNTAX