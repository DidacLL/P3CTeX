\ProcessKeysOptions{ pxORL }

%% Public LaTeX2e API

\NewDocumentCommand{\pxORLsetup}{m}
{ \pxORL_set_options:n { #1 } }

\NewDocumentCommand{\pxORLsavepreset}{m m}
{ \pxORL_save_preset:nn { #1 } { #2 } }

\NewDocumentCommand{\pxORLusepreset}{m}
{ \pxORL_use_preset:n { #1 } }

% \pxORLprint[<local options>]{<students>}
%
% Input:
%   {Student Name}/{photo-file},
%   {Student Name}/,
%   {Student Name}/{photo-file}
%
% Empty or missing photos print a P3CTeX-style placeholder when
% print-placeholders=true.
\NewDocumentCommand{\pxORLprint}{ O{} +m }
{
	\group_begin:
	\pxORL_set_options:n { #1 }
	\pxORL_print:n { #2 }
	\group_end:
}

% Catalan/Spanish semantic alias, still mapped to the pxORL API.
\NewDocumentCommand{\pxOrla}{ O{} +m }
{ \pxORLprint[#1]{#2} }

