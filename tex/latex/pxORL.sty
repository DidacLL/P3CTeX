\ProvidesExplPackage{pxORL}{2026/07/03}{v0.1}
{P3CTeX orla / graduation board module}

% Fallbacks for standalone usage. P3CTeX/pxGDX already define these.
\providecolor{primaryColor}{rgb}{0,0,.47}
\providecolor{secondaryColor}{rgb}{.45,.93,1}
\providecolor{neutralColor}{cmyk}{0.5,0.14,0.16,0}
\providecolor{darkColor}{rgb}{.1,.25,.5}
\providecolor{lightColor}{cmyk}{0,0,0,0.3}
\providecolor{lighterColor}{rgb}{1,1,1}

\file_input:n {pxORL.code.tex}
\pxORL_save_preset:nn { p3c-uoc-orla }
{
	maincolor      = primaryColor,
	accentcolor    = secondaryColor,
	neutralcolor   = neutralColor,
	textcolor      = darkColor,
	papercolor     = lighterColor,
	framecolor     = primaryColor,
	photo-bg-color = lighterColor,

	title-size     = \huge,
	subtitle-size  = \large,
	name-size      = \small,
	title-max      = 30pt,

	page-margin    = 9mm,
	board-padding  = 10mm,

	logo-left      = img/pxhlogo.png,
	logo-right     = img/pxflogo.png,
	logo-height    = .78cm,
	logo-left-width  = 4.6cm,
	logo-right-width = 4.2cm,

	auto-columns   = true,
	auto-size      = true,
	print-placeholders = true,
	clearpage      = true
}
