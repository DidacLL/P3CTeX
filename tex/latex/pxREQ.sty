% Requirements-writing tools, reusing P3CTeX colours and table layout.
\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3,xparse,l3keys2e}
\RequirePackage{pxTAB,tcolorbox}
\tcbuselibrary{breakable,skins}
\ProvidesExplPackage{pxREQ}{2026/10/30}{0.1}{Requirements and analysis tools}
\file_input:n {pxREQ.code.tex}
\NewDocumentCommand\pxREQsetup{m}{\keys_set:nn {pxREQ}{#1}}
% Per-card options are ordinary tcolorbox options, applied after the defaults.
\NewDocumentEnvironment{pxUserStory}{O{} m}
  {\__pxreq_begin:nnn {story}{#1}{#2}}{\end{tcolorbox}}
\NewDocumentEnvironment{pxScenario}{O{} m}
  {\__pxreq_begin:nnn {scenario}{#1}{#2}}{\end{tcolorbox}}
\NewDocumentCommand\pxAsA{+m}{\__pxreq_field:nn {as-a}{#1}}
\NewDocumentCommand\pxIWant{+m}{\__pxreq_field:nn {i-want}{#1}}
\NewDocumentCommand\pxSoThat{+m}{\__pxreq_field:nn {so-that}{#1}}
\NewDocumentCommand\pxAcceptanceCriteria{+m}{\__pxreq_field:nn {acceptance}{#1}}
\NewDocumentCommand\pxGiven{+m}{\__pxreq_field:nn {given}{#1}}
\NewDocumentCommand\pxWhen{+m}{\__pxreq_field:nn {when}{#1}}
\NewDocumentCommand\pxThen{+m}{\__pxreq_field:nn {then}{#1}}
% Optional settings are pxTAB options; lists and paragraphs work in all cells.
\NewDocumentCommand\pxSWOT{O{} +m +m +m +m}
  {\__pxreq_swot:nnnnn {#1}{#2}{#3}{#4}{#5}}
\NewCommandCopy\pxDAFO\pxSWOT
\ProcessKeysOptions{pxREQ}
\endinput
