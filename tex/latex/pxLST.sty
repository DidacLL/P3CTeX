%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%      --  PUBLIC LaTeX2e API   --         %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Package configuration (pxLST key family).
%%   \pxLSTsetup{key=value,...} applies keys in current TeX group scope.
%%   At document level, effects are global until overridden or group ends.
%%   Preset names are registered via \pxLSTsavepreset{name}{option-string}
%%   and applied via \pxLSTusepreset{name} or key preset=name.
%% \pxCodeSet[<palette>]{<language>}[<style>]
%% Select a palette and set the global listings language/style.
%% #1 - palette (default dark).  #2 - listings language.  #3 - listings style (default pxlst).
\NewDocumentCommand{\pxCodeSet}{O{dark} m O{pxlst}}{%
  \pxLSTpaletteSelect{#1}%
  \lstset{%
    language=#2,%
    style=#3%
  }%
}
%% -----------------------------------------------------------------------
%% pxCode -- inline code listing with optional local key overrides.
%%   #1 = optional key-value options (local to this environment)
%%   #2 = label string (displayed in title bar)
%% \begin{pxCode}[<listing options>]{<label>} ... \end{pxCode}
%% Standard titled code-listing environment.
%% #1 - optional listings options.  #2 - title/label text shown in the title bar.
\newtcblisting{pxCode}[2][]{%
	listing~options={style=pxlst,#1},
	listing~only,%
	arc=.25em,outer~arc=.25em,%
	drop~lifted~shadow,%
	colback=pxbg!95!,
	colframe=pxbg!70!,
	coltext=pxfg,
	toptitle=-.1em,%
	title=\small\hspace*{\fill}\textbf{\ttfamily \color{pxfg!75!} #2}%
}
%% \begin{miniCode}[<width>] ... \end{miniCode}
%% Compact untitled listing box.
%% #1 - box width, default .8\linewidth.
\newtcblisting{miniCode}[1][.8\linewidth]{%
	width=#1,
	listing~options={style=pxlst,numbers=none,xleftmargin=0.4em},
	listing~only,%
	arc=.25em,outer~arc=.25em,%
	drop~lifted~shadow,%
	colback=pxbg!60!,
	colframe=pxbg!30!,
	coltext=pxfg,
}
%% -----------------------------------------------------------------------
%% pxCODE -- convenience environment with Darcula + pxJava defaults.
%%   Signature mirrors the legacy p3xLST environment:
%%     [#1] = language (defaults to pxJava)
%%      #2 = label shown in the title bar.
%%   Internally delegates to the pxLST key pipeline via configure.
%% \begin{pxCode*}[<listing options>]{<label>} ... \end{pxCode*}
%% Alternate darker code-listing environment with the same argument contract as pxCode.
\newtcblisting{pxCode*}[2][]{%
	listing~options={style=pxlst,#1},
	listing~only,%
	arc=.25em,outer~arc=.25em,%
	colback=pxbg!70!gray,
	colframe=pxbg!30!pxbg,
	coltext=pxbg!90!,
	drop~lifted~shadow,%
	toptitle=-.1em,%
	title=\color{pxbg!35!pxfg}\small\hspace*{\fill}\textbf{\ttfamily #2}%
}
%% -----------------------------------------------------------------------
%% pxCodeBox -- code listing with side-note comment panel (non-breakable).
%%   #1 = optional key-value options (local)
%%   #2 = label string (cross-reference anchor; inserts \label{cdbx:#2})
%%   #3 = title text (title bar)
%%   #4 = short note (comment panel identifier label)
%%   #5 = caption text (comment panel body)
%% \begin{CodeBox}[<listing options>]{<label>}{<title>}{<note id>}{<note text>} ... \end{CodeBox}
%% Non-breakable listing with an external comment panel and cross-reference label cdbx:<label>.
%% #1 - listings options.  #2 - label id.  #3 - title.  #4 - short note id.  #5 - note text.
\newtcblisting{CodeBox}[5][]{%
	listing~options={style=pxlst,#1},
  enhanced,%
  colback=pxbg!90!,
  colframe=pxbg!60!,
  coltext=pxfg,
  listing~and~comment,%
  comment=\raggedleft\parbox[b]{.1\linewidth}{%
    \textit{\footnotesize\color{gray!70!}\ttfamily codebox:\textbf{{[}#2{]}}}%
  }\hspace*{.05\linewidth}\parbox[c]{.8\linewidth}{%
    \centering #5%
  },%
  drop~lifted~shadow,%
  arc=.25em,outer~arc=.25em,%
  toptitle=-.1em,%
  title~after~break=%
    \scriptsize\texttt{\bfseries\color{gray!50!}\hspace*{-1em}..continues~from~page~\pageref{cdbx:#2}}%
    \textbf{\ttfamily\small\hspace*{\fill}#3},%
  title=%
    \scriptsize\texttt{\bfseries\color{gray!50!}\hspace*{-1em}codebox:\color{gray!80!}#4}%
    \textbf{\ttfamily\small\hspace*{\fill}#3\label{cdbx:#2}},%
  comment~outside~listing,%
  listing~above~comment%
}
%% -----------------------------------------------------------------------
%% pxCodeBreak -- same as pxCodeBox but forces breakable across pages.
%%   Arguments identical to pxCodeBox.
%% \begin{CodeBox*}[<listing options>]{<label>}{<title>}{<note id>}{<note text>} ... \end{CodeBox*}
%% Breakable CodeBox variant; continuation titles refer back to cdbx:<label>.
\newtcblisting{CodeBox*}[5][]{%
	listing~options={style=pxlst,#1},
  enhanced,%
  breakable,%
  listing~and~comment,%
  comment=\raggedleft\parbox[b]{.1\linewidth}{%
    \textit{\footnotesize\color{gray!70!}\ttfamily codebox:\textbf{{[}#2{]}}}%
  }\hspace*{.05\linewidth}\parbox[c]{.8\linewidth}{%
    \centering #5%
  },%
  drop~lifted~shadow,%
  colback=pxbg!90!,
  colframe=pxbg!60!,
  coltext=pxfg,
  arc=.25em,outer~arc=.25em,%
  toptitle=-.1em,%
  title~after~break=%
    \scriptsize\texttt{\bfseries\color{gray!50!}\hspace*{-1em}..continues~from~page~\pageref{cdbx:#2}}%
    \textbf{\ttfamily\small\hspace*{\fill}#3},%
  title=%
    \scriptsize\texttt{\bfseries\color{gray!50!}\hspace*{-1em}codebox:\color{gray!80!}#4}%
    \textbf{\ttfamily\small\hspace*{\fill}#3\label{cdbx:#2}},%
  comment~outside~listing,%
  listing~above~comment%
}
%% \pxCodeFile[<language>]{<file>}[<title>]
%% Typeset an external file through the standard breakable pxLST file renderer.
%% #1 - optional listings language.  #2 - source filename/path.  #3 - optional header title (defaults to #2).
\NewDocumentCommand{\pxCodeFile}{ O{} m O{#2} }
  { \pxLST_input_file:nnn { #1 } { #2 } { #3 } }

%% \pxCodeFileInput[<language>]{<file>}[<title>]
%% Convenience alias for \pxCodeFile (defaults to pxJLex when language is omitted).
\NewDocumentCommand{\pxCodeFileInput}{ O{pxJLex} m O{#2} }
  { \pxLST_input_file:nnn { #1 } { #2 } { #3 } }

%% \pxCodeIn[<language>]{<code>}[<style>]
%% Render one inline snippet; optional language/style changes are local to this command.
%% #1 - optional listings language.  #2 - inline code.  #3 - listings style (default pxlst).
\NewDocumentCommand{\pxCodeIn}{ O{} m O{pxlst}}
  {
    \group_begin:
      \tl_if_blank:nTF { #1 }
        { \lstset{ xleftmargin=2em, xrightmargin=2em, framesep=1em, style=#3 } }
        { \lstset{ xleftmargin=2em, xrightmargin=2em, framesep=1em, language=#1, style=#3 } }
      \__pxlst_code_render_inline:n { #2 }
    \group_end:
  }
\endinput
