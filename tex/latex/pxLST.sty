%% =================================
%% ===== FILE INPUT FUNCTION ========
%% =================================
%% \pxLST_input_file:nnn {<language>}{<file>}{<title>}
%% Typeset an external source file in a breakable pxLST tcolorbox.
%% #1 - listings language name.  #2 - source filename/path.  #3 - header title.
\cs_new_protected:Npn \pxLST_input_file:nnn #1 #2 #3 {
	\tl_if_blank:nTF {#1}
		{
			\tcbinputlisting{
				listing~options={style=pxlst},
				colback=pxbg!90!,
				colframe=pxbg!60!,
				coltext=pxfg,
				listing~file=#2,
				listing~only,
				breakable,
				arc=.25em, outer~arc=.25em,
				toptitle=-.1em,
				title=\small\hspace*{\fill}\textbf{\ttfamily #3}
			}
		}
		{
			\tcbinputlisting{
				listing~options={style=pxlst,language=#1},
				colback=pxbg!90!,
				colframe=pxbg!60!,
				coltext=pxfg,
				listing~file=#2,
				listing~only,
				breakable,
				arc=.25em, outer~arc=.25em,
				toptitle=-.1em,
				title=\small\hspace*{\fill}\textbf{\ttfamily #3}
			}
		}
}
\cs_new_protected:Npn \pxLST_input_file:nn #1 #2 {
	\pxLST_input_file:nnn {#1} {#2} {#2}
}
%% =================================
%% ===== INLINE CODE RENDER ==========
%% =================================
%% Small tcolorbox with lstinline for single-snippet inline code.
%% \__pxlst_code_render_inline:n {<code>}
%% Render one inline code fragment inside a compact tcolorbox using \lstinline.
%% #1 - inline source text.
\cs_new_protected:Npn \__pxlst_code_render_inline:n #1 {
	\tcbox[
	nobeforeafter,
	size=minimal,
	colback=pxbg!90!,
	colframe=pxbg!60!,
	coltext=pxfg,
	boxrule=0.4pt,
	arc=0.5mm,
	left=1.5pt,
	right=1.5pt,
	top=0.5pt,
	bottom=0.5pt,
	]
	{ \lstinline{#1} }
}


