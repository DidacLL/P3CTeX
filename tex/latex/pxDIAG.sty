\ProcessKeysOptions{ pxDIAG }

%% =======================================================
%% PUBLIC LaTeX2e API
%% =======================================================

%% --- Configuration & Presets ---
%% \pxDiagramSetup{<key=value,...>}
\NewDocumentCommand{\pxDiagramSetup}{m}
  { \pxDIAG_set_options:n {#1} }

%% \pxDiagramSavePreset{<name>}{<keys>}
\NewDocumentCommand{\pxDiagramSavePreset}{m m}
  { \pxDIAG_save_preset:nn {#1} {#2} }

%% \pxDiagramUsePreset{<name>}
\NewDocumentCommand{\pxDiagramUsePreset}{m}
  { \pxDIAG_use_preset:n {#1} }

%% --- Canvas Environment & Annotations ---
%% \begin{pxDiagram}[<local-keys>] ... \end{pxDiagram}
%% Composable coordinate-grid canvas for custom multi-step diagrams and UOC boards.
\NewDocumentEnvironment{pxDiagram}{ O{} +b }
  { \__pxdiag_diagram_render:nn {#1} {#2} }
  {}

%% \pxDIAGNote[<tikz-node-opts>]{<x,y>}{<text>}
%% Place a text label or section note inside a pxDiagram canvas.
\NewDocumentCommand{\pxDIAGNote}{ O{} m m }
  { \__pxdiag_canvas_note:nnn {#1} {#2} {#3} }

%% =======================================================
%% PRIORITY 1: TOMBSTONE (T-DIAGRAMS)
%% =======================================================

%% \pxTCompiler[<opts>]{<source>}{<target>}{<impl>}[<step-id>][<x,y>]
%% Render a Tombstone Compiler T-piece (standalone or at <x,y> inside pxDiagram).
\NewDocumentCommand{\pxTCompiler}{ O{} m m m O{} O{} }
  { \__pxdiag_tcompiler:nnnnnn {#1} {#2} {#3} {#4} {#5} {#6} }

%% \pxTProgram[<opts>]{<name>}{<lang>}[<x,y>]
%% Render a Tombstone Program piece (standalone or at <x,y> inside pxDiagram).
\NewDocumentCommand{\pxTProgram}{ O{} m m O{} }
  { \__pxdiag_tprogram:nnnn {#1} {#2} {#3} {#4} }

%% \pxTMachine[<opts>]{<platform>}[<upper-lang>][<x,y>]
%% Render a Tombstone Machine (or Virtual Machine when <upper-lang> is set).
\NewDocumentCommand{\pxTMachine}{ O{} m O{} O{} }
  { \__pxdiag_tmachine:nnnn {#1} {#2} {#3} {#4} }

%% \pxTInterpreter[<opts>]{<lang>}{<impl>}[<x,y>]
%% Render a Tombstone Interpreter block.
\NewDocumentCommand{\pxTInterpreter}{ O{} m m O{} }
  { \__pxdiag_tinterpreter:nnnn {#1} {#2} {#3} {#4} }

%% \pxTombstoneRun[<opts>]{<prog>}{<mach>}[<vm-lang>]
%% Auto-docked execution of Program <prog> on Machine <mach>.
\NewDocumentCommand{\pxTombstoneRun}{ O{} m m O{} }
  { \__pxdiag_tombstone_run:nnnn {#1} {#2} {#3} {#4} }

%% \pxTombstoneInterpret[<opts>]{<prog>}{<lang>}{<mach>}
%% Auto-docked interpretation of Program <prog> in <lang> on Interpreter <lang>/<mach> + Machine <mach>.
\NewDocumentCommand{\pxTombstoneInterpret}{ O{} m m m }
  { \__pxdiag_tombstone_interpret:nnnn {#1} {#2} {#3} {#4} }

%% \pxTombstoneVM[<opts>]{<lang>}{<mach>}
%% Visual equivalence between Interpreter(<lang>,<mach>) + Machine(<mach>) and VM(<lang>,<mach>).
\NewDocumentCommand{\pxTombstoneVM}{ O{} m m }
  { \__pxdiag_tombstone_vm:nnn {#1} {#2} {#3} }

%% \pxTombstoneCompile[<opts>]{<prog>}{<src>}{<tgt>}{<impl>}[<mach>]
%% Auto-docked compilation of Program <prog> from <src> to <tgt> via Compiler <src>-><tgt>/<impl>.
%% Supports <src> = {prog_lang/compiler_src} (e.g. {Swift/A}) and <tgt> = {compiler_tgt/out_lang}
%% for unknown-variable Tombstone exercises.
\NewDocumentCommand{\pxTombstoneCompile}{ O{} m m m m O{} }
  { \__pxdiag_tombstone_compile:nnnnnn {#1} {#2} {#3} {#4} {#5} {#6} }

%% \pxTombstoneChain[<opts>]{<prog>}{<src1>/<tgt1>/<impl1>[/<label1>], ...}
%% Auto-docked multi-stage translation chain (e.g. Compiler + Linker or Preprocessor + Compiler).
\NewDocumentCommand{\pxTombstoneChain}{ O{} m m }
  { \__pxdiag_tombstone_chain:nnn {#1} {#2} {#3} }

%% \pxTombstoneCompileCompiler[<opts>]{<src1>}{<tgt1>}{<impl1>}{<src2>}{<tgt2>}{<impl2>}
%% Auto-docked compilation of Compiler 1 (<src1>-><tgt1>/<impl1>) over Host Compiler 2 (<src2>-><tgt2>/<impl2>),
%% producing the compiled Compiler 3 (<src1>-><tgt1>/<tgt2>).
\NewDocumentCommand{\pxTombstoneCompileCompiler}{ O{} m m m m m m }
  { \__pxdiag_tombstone_compile_compiler:nnnnnnn {#1} {#2} {#3} {#4} {#5} {#6} {#7} }

%% \pxTombstoneBootstrap[<opts>]{<lang>}{<old-mach>}{<new-mach>}
%% Complete two-stage cross-compilation / bootstrapping diagram (Stage 1 + Stage 2).
\NewDocumentCommand{\pxTombstoneBootstrap}{ O{} m m m }
  { \__pxdiag_tombstone_bootstrap:nnnn {#1} {#2} {#3} {#4} }

%% =======================================================
%% PRIORITY 2: TRANSLATOR, PIPELINE & IR HUB DIAGRAMS
%% =======================================================

%% \pxTranslatorBox[<opts>]{<input>}{<translator>}{<output>}[<errors>][<data>]
%% Render a Translator / Compiler / Interpreter I/O block diagram.
\NewDocumentCommand{\pxTranslatorBox}{ O{} m m m O{} O{} }
  { \__pxdiag_translator_box:nnnnnn {#1} {#2} {#3} {#4} {#5} {#6} }

%% \pxCompileRunFlow[<opts>]{<source>}{<compiler>}{<mid-code>}{<executor>}{<results>}[<errors>][<data>]
%% Render a two-stage compilation + execution (or precompiled interpretation) pipeline.
\NewDocumentCommand{\pxCompileRunFlow}{ O{} m m m m m O{} O{} }
  { \__pxdiag_compile_run_flow:nnnnnnnn {#1} {#2} {#3} {#4} {#5} {#6} {#7} {#8} }

%% \pxCompilerModel[<opts>]
%% Render the complete UOC Front-End / Back-End compiler architecture diagram.
\NewDocumentCommand{\pxCompilerModel}{ O{} }
  { \__pxdiag_compiler_model:n {#1} }

%% \pxCompilerPipeline[<opts>]{<phase1, phase2, ...>}[<shared-bus-label>]
%% Render a customizable multi-phase pipeline with an optional shared symbol/error bus.
\NewDocumentCommand{\pxCompilerPipeline}{ O{} m O{} }
  { \__pxdiag_compiler_pipeline:nnn {#1} {#2} {#3} }

%% \pxIRHub[<opts>]{<source-langs-clist>}{<ir-label>}{<target-platforms-clist>}
%% Render an M-to-N Intermediate Representation fan-in / fan-out hub diagram.
\NewDocumentCommand{\pxIRHub}{ O{} m m m }
  { \__pxdiag_ir_hub:nnnn {#1} {#2} {#3} {#4} }

%% =======================================================
%% PRIORITY 3: PARSE TREES, AUTOMATA & GRAPHS
%% =======================================================

%% \pxSyntaxTree[<opts>]{<nodes-spec>}{<edges-spec>}
%% Render a hierarchical syntax/parse tree with non-terminals and terminal token/lexeme dual boxes.
\NewDocumentCommand{\pxSyntaxTree}{ O{} m m }
  { \__pxdiag_syntax_tree:nnn {#1} {#2} {#3} }

%% \pxAutomaton[<opts>]{<states-spec>}{<transitions-spec>}
%% Render a finite state automaton (DFA / NFA / PDA) from state and transition lists.
\NewDocumentCommand{\pxAutomaton}{ O{} m m }
  { \__pxdiag_automaton:nnn {#1} {#2} {#3} }

%% \pxTransitionTable[<opts>]{<alphabet-clist>}{<state / role / t1, t2, ... [/ partition]; ...>}
%% Render a formal automaton transition table (\delta) with initial/accepting markers and optional equivalence partition column (\Pi).
\NewDocumentCommand{\pxTransitionTable}{ O{} m m }
  { \__pxdiag_transition_table:nnn {#1} {#2} {#3} }

%% \pxAutomatonTrace[<opts>]{<steps-spec>}[<result-badge>]
%% Render a step-by-step word recognition trace on an automaton with an optional Accepted/Rejected badge.
\NewDocumentCommand{\pxAutomatonTrace}{ O{} m O{} }
  { \__pxdiag_automaton_trace:nnn {#1} {#2} {#3} }

%% \pxGraph[<opts>]{<nodes-spec>}{<edges-spec>}
%% Render a directed, undirected, weighted, or heuristic search graph (with start/goal/visited/open/path states and node badges).
\NewDocumentCommand{\pxGraph}{ O{} m m }
  { \__pxdiag_graph:nnn {#1} {#2} {#3} }

%% =======================================================
%% PRIORITY 4: BNF GRAMMARS, DERIVATIONS, REGEX, LEXEMES & IR
%% =======================================================

%% \pxBNF[<opts>]{<lhs1> -> <rhs1>; <lhs2> -> <rhs2>; ...}
%% Render a formatted BNF / Context-Free Grammar production block.
\NewDocumentCommand{\pxBNF}{ O{} m }
  { \__pxdiag_bnf:nn {#1} {#2} }

%% \pxDerivation[<opts>]{<step1> [/ <rule1>]; <step2> [/ <rule2>]; ...}
%% Render a step-by-step formal grammar derivation sequence.
\NewDocumentCommand{\pxDerivation}{ O{} m }
  { \__pxdiag_derivation:nn {#1} {#2} }

%% \pxRegEx[<opts>]{<pattern>}[<description>]
%% Render a formal regular expression or JLex pattern verbatim with literal ASCII characters and zero space-markers.
\NewDocumentCommand{\pxRegEx}{ O{} +v O{} }
  { \__pxdiag_regex:nnn {#1} {#2} {#3} }

%% \pxRegExList[<opts>]{<name1> / <pattern1> [/ <desc1>]; <name2> / <pattern2> [/ <desc2>]; ...}
%% Render a structured table of named regular expressions / lexical definitions.
\NewDocumentCommand{\pxRegExList}{ O{} m }
  { \__pxdiag_regex_list:nn {#1} {#2} }

%% \pxLexemeTable[<opts>][<input-statement>]{<TOKEN1> / <val1>; <TOKEN2> / <val2>; ...}
%% Render a lexical analysis token/value table.
\NewDocumentCommand{\pxLexemeTable}{ O{} O{} m }
  { \__pxdiag_lexeme_table:nnn {#1} {#2} {#3} }

%% \pxIRCompare[<opts>]{<left-title>}{<left-code-lines>}{<right-title>}{<right-code-lines>}
%% Render a side-by-side 3-address IR vs. optimized code comparison block.
\NewDocumentCommand{\pxIRCompare}{ O{} m m m m }
  { \__pxdiag_ir_compare:nnnnn {#1} {#2} {#3} {#4} {#5} }

%% =======================================================
%% PRIORITY 5: LOGIC, SETS, FLOWCHARTS & LOW-LEVEL MEMORY
%% =======================================================

%% \pxInferenceRule[<opts>]{<premise1, premise2, ...>}{<conclusion>}[<rule-name>]
%% Render a formal logic / type system deduction rule.
\NewDocumentCommand{\pxInferenceRule}{ O{} m m O{} }
  { \__pxdiag_inference_rule:nnnn {#1} {#2} {#3} {#4} }

%% \pxVenn[<opts>]{<set-A>}{<set-B>}[<set-C>][<intersection-label>]
%% Render a 2-set or 3-set Venn/Euler diagram.
\NewDocumentCommand{\pxVenn}{ O{} m m O{} O{} }
  { \__pxdiag_venn:nnnnn {#1} {#2} {#3} {#4} {#5} }

%% \pxLogicGroup[<opts>]{<inner-group>, <middle-group>, <outer-group>, ...}
%% Render nested set/language hierarchy containers (e.g. Chomsky hierarchy or 1GL..4GL).
\NewDocumentCommand{\pxLogicGroup}{ O{} m }
  { \__pxdiag_logic_hierarchy:nn {#1} {#2} }

%% \pxFlowchart[<opts>]{<nodes-spec>}{<edges-spec>}
%% Render an algorithmic flowchart with start/process/decision/io/end blocks.
\NewDocumentCommand{\pxFlowchart}{ O{} m m }
  { \__pxdiag_flowchart:nnn {#1} {#2} {#3} }

%% \pxMemoryMap[<opts>]{<addr1> / <val1> [/ <note1>]; <addr2> / <val2> [/ <note2>]; ...}
%% Render a visual byte/word memory layout diagram with addresses, cell values, and annotations.
\NewDocumentCommand{\pxMemoryMap}{ O{} m }
  { \__pxdiag_memory_map:nn {#1} {#2} }

%% \pxEndianCompare[<opts>]{<word-header>}{<addr1> / <le1> / <be1> [/ <note1>]; ...}
%% Render a side-by-side Little-Endian vs. Big-Endian memory layout comparison diagram.
\NewDocumentCommand{\pxEndianCompare}{ O{} m m }
  { \__pxdiag_endian_compare:nnn {#1} {#2} {#3} }

%% \pxRegisterMap[<opts>]{<bits1> / <name1> [/ <val1>]; <bits2> / <name2> [/ <val2>]; ...}
%% Render a hardware register or instruction encoding bitfield diagram.
\NewDocumentCommand{\pxRegisterMap}{ O{} m }
  { \__pxdiag_register_map:nn {#1} {#2} }

%% =======================================================
%% PRIORITY 6: MACHINE LEARNING, AI & DATA MINING
%% =======================================================

%% \pxDecisionTree[<opts>]{<nodes-spec>}{<edges-spec>}
%% Render a Decision Tree (ID3 / C4.5 / CART) with attribute nodes, information gain badges, branch labels, and terminal class leaves.
\NewDocumentCommand{\pxDecisionTree}{ O{} m m }
  { \__pxdiag_decision_tree:nnn {#1} {#2} {#3} }

%% \pxNeuralNet[<opts>]{<layer1-title / n1, n2, ... [/ role-or-act]; ...>}[<weighted-edges-spec>]
%% Render a Multi-Layer Perceptron (MLP) or Neural Network with automatic feed-forward connections and optional edge weights.
\NewDocumentCommand{\pxNeuralNet}{ O{} m O{} }
  { \__pxdiag_neural_net:nnn {#1} {#2} {#3} }

%% \pxConfusionMatrix[<opts>]{<classes-clist>}{<row1-clist>; <row2-clist>; ...}[<metrics-summary>]
%% Render a 2x2 or NxN Confusion Matrix with diagonal/off-diagonal highlighting and optional Precision/Recall/F1 summary bar.
\NewDocumentCommand{\pxConfusionMatrix}{ O{} m m O{} }
  { \__pxdiag_confusion_matrix:nnnn {#1} {#2} {#3} {#4} }

%% \pxFuzzyPlot[<opts>]{<xmin,xmax>}{<label / color / x1,y1 / x2,y2 / ...; ...>}
%% Render a Fuzzy Logic membership function plot (\mu(x) \in [0,1]) with trapezoidal and triangular fuzzy sets.
\NewDocumentCommand{\pxFuzzyPlot}{ O{} m m }
  { \__pxdiag_fuzzy_plot:nnn {#1} {#2} {#3} }

\endinput
