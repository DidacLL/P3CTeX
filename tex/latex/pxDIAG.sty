%%  This file is part of the P3CTeX project.
%%
%%  Author: Scvria
%%  File: pxDIAG.sty
%%  Version: v0.2 (10/2026)
%%  Description:
%%    P3CTeX Computation, Compilers & Logic Diagrams module.
%%    Provides an ergonomic, list-driven and key-value LaTeX2e API for:
%%      1. Tombstone (T-diagrams): compilers, programs (keyhole & rect),
%%         machines, interpreters, virtual machines, auto-docked compilation
%%         (including unknown/mismatched port exercises), linker chains,
%%         cross-compilation, bootstrapping, and UOC exercise boards.
%%      2. Translator & Pipeline Blocks: I/O translator boxes, compile/run
%%         flows, Front-End/Back-End compiler architecture & M-to-N IR hubs.
%%      3. Parse Trees, Automata & Graphs: syntax/semantic trees with
%%         terminal token/lexeme badges, finite automata & computation graphs.
%%      4. Grammar, BNF, Regex & IR Helpers: BNF productions, formal derivations,
%%         regular expression blocks/tables, lexical token tables & side-by-side
%%         3-address IR optimization blocks.
%%      5. Logic, Sets, Flowcharts & Low-Level Memory/Registers: Gentzen
%%         inference rules, Venn/Euler sets, nested language hierarchies,
%%         algorithmic flowcharts, memory maps, endianness comparisons &
%%         hardware register bitfield diagrams.
%%
%%  This file may be distributed and/or modified:
%%   1. under the LaTeX Project Public License and/or
%%   2. under the GNU Public License.
%% =======================================================
\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3}
\RequirePackage{xparse,l3keys2e}
\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage{colortbl}
\RequirePackage{array}
\RequirePackage{amstext}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,shapes.geometric,shapes.misc,fit,calc,automata,shadows}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,xparse}

\ProvidesExplPackage{pxDIAG}{2026/10/27}{v0.2}
  {P3CTeX computation, compilers and logic diagrams module}

% Fallback P3CTeX palette colors for standalone usage outside P3CTeX.cls
\providecolor{primaryColor}{rgb}{0,0,.47}
\providecolor{secondaryColor}{rgb}{.45,.93,1}
\providecolor{neutralColor}{cmyk}{0.5,0.14,0.16,0}
\providecolor{darkColor}{rgb}{.1,.25,.5}
\providecolor{lightColor}{cmyk}{0,0,0,0.3}
\providecolor{lighterColor}{rgb}{1,1,1}

\providecommand{\pxDEFdiagcompilation}{Compilation~time}
\providecommand{\pxDEFdiagexecution}{Execution~time}
\providecommand{\pxDEFdiagactual}{Actual~classes}
\providecommand{\pxDEFdiagpred}{Predictions}
\providecommand{\pxDEFdiaginput}{Input}
\providecommand{\pxDEFdiagtoken}{Token}
\providecommand{\pxDEFdiagvalue}{Value}
\file_input:n {pxDIAG.code.tex}

