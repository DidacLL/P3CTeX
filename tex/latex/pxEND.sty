%% Shared annex, glossary and bibliography implementation for P3CTeX and LaTeX.
%% Public entry points are here; storage, formatting and ordering live in pxEND.code.tex.
\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3,xparse,l3keys2e,hyperref}
\IfPackageLoadedTF{glossaries}{}{\RequirePackage[acronym]{glossaries}}
\ProvidesExplPackage{pxEND}{2026/10/31}{0.1}{Document end matter}
%% Use the shared string table, including standalone documents; do not duplicate captions.
\cs_if_exist:NF \pxDEFtocname
  {\file_input:n {pxTXT.code.tex}
   \cs_if_exist:NTF \languagename
     {\exp_args:Ne \str_case:nnF {\languagename}
       {{catalan}{} % pxTXT initializes Catalan by default.
        {spanish}{\_pxcore_set_language_spanish}}
       {\_pxcore_set_language_english}}
     {\_pxcore_set_language_english}}
\file_input:n {pxEND.code.tex}
%% \pxGlossarySetup{<keys>}: customise automatic/manual printing, selected types, titles and style.
\NewDocumentCommand\pxGlossarySetup{m}{\keys_set:nn {pxEND/glossary}{#1}}
%% \pxGlossaryFile{<path>}: load shared entry definitions from a native TeX preamble file.
\NewDocumentCommand\pxGlossaryFile{m}{\file_input:n {#1}}
%% \pxPrintGlossary[<keys>]: optional placement for one type (type=main by default); print once.
\NewDocumentCommand\pxPrintGlossary{O{}}
  {\group_begin:\keys_set:nn {pxEND/glossary}{#1}
   \exp_args:NV \ifglossaryexists \l__pxgls_type_tl
     {\__pxgls_print:}{\msg_error:nnx {pxEND/glossary}{type}{\l__pxgls_type_tl}}
   \group_end:}
%% \pxPrintGlossaries[<keys>]: place enabled term/acronym lists now; automatic output skips them.
\NewDocumentCommand\pxPrintGlossaries{O{}}
  {\group_begin:
   \keys_set:nn {pxEND/glossary}{#1}
   \bool_if:NT \l__pxgls_terms_bool
     {\tl_set:Nn \l__pxgls_type_tl {main}\__pxgls_print:}
   \bool_if:NT \l__pxgls_acronyms_bool
     {\tl_set:Nn \l__pxgls_type_tl {acronym}\__pxgls_print:}
   \group_end:}
%% \pxAcronym[<options>]{<id>}{<short>}{<long>}
%% Register an acronym once in the document or shared preamble; use with \gls{id}.
%% #1 - standard glossaries entry options; #2 - stable label;
%% #3 - short form (may be a shared macro); #4 - expanded name (may be a macro).
\NewDocumentCommand\pxAcronym{O{} m m m}{\newacronym[#1]{#2}{#3}{#4}}
%% \pxTerm[<options>]{<id>}{<name>}{<definition>}
%% Register a defined term; automatic lists include it when referenced with \gls.
%% #1 - glossaries options; #2 - label; #3 - displayed name; #4 - definition.
\NewDocumentCommand\pxTerm{O{} m m +m}
  {\newglossaryentry{#2}{name={#3},description={#4},#1}}
%% \pxTerms{<id={name=...,description=...},...>}
%% Register a shared set of terms with standard glossaries fields.
%% #1 - entry map; braces protect commas and macros in each definition.
\NewDocumentCommand\pxTerms{+m}
  {\keyval_parse:NNn \__pxgls_missing_entry:n \__pxgls_term:nn {#1}}
%% \pxAcronyms{<id={short=...,long=...},...>}
%% Register a shared acronym set; extra fields are passed to glossaries.
%% #1 - entry map containing short and long fields for each label.
\NewDocumentCommand\pxAcronyms{+m}
  {\keyval_parse:NNn \__pxgls_missing_entry:n \__pxgls_acronym:nn {#1}}
%% \GL{<id>} / \GL*{<id>}: existing short/long acronym shorthand.
%% Available whenever the glossary tool is loaded, through either class key.
\ProvideDocumentCommand\GL{s m}{\IfBooleanTF{#1}{\acrlong{#2}}{\acrshort{#2}}}

%% \pxAnnexSetup{<options>}: scoped annex defaults (level, name, label, toc, pagebreak).
\NewDocumentCommand\pxAnnexSetup{m}{\keys_set:nn {pxEND/annex}{#1}}
%% \pxAnnex[<options>]{<title>}{<body>}: explicit immediate placement.
%% #1 annex formatting; #2 heading; #3 native TeX content. Main counters are restored.
\NewDocumentCommand\pxAnnex{O{} m +m}{\__pxann_print:nnn {#1}{#2}{#3}}
%% \pxAddAnnex[<options>]{<title>}{<body>}: automatic end placement.
%% #1 registration-time options; #2 heading; #3 unexpanded content.
%% Example: \pxAddAnnex[label=ann:data]{Data}{\pxInput[as=text]{results.csv}}
\NewDocumentCommand\pxAddAnnex{O{} m +m}{\pxEND_add_annex:nnn {#1}{#2}{#3}}
%% \pxPrintAnnexes: place queued annexes here, once, in registration order.
\NewDocumentCommand\pxPrintAnnexes{}{\__pxann_print_pending:}
%% \pxEndMatterSetup{<options>}: control common placement/order and component styling.
%% #1 print=auto/manual, order={bibliography,annexes,glossaries}, glossary={...}, annex={...}.
%% Example: \pxEndMatterSetup{annex={name=\appendixname},glossary={include=used}}
\NewDocumentCommand\pxEndMatterSetup{m}{\keys_set:nn {pxEND}{#1}}
%% \pxPrintEndMatter: optional manual placement of all registered end matter.
\NewDocumentCommand\pxPrintEndMatter{}
  {\group_begin:\bool_set_true:N \l__pxend_manual_bool\__pxend_print:\group_end:}
%% \pxBibliography[<BibTeX style>]{<databases>}
%% #1 style, default plain; #2 comma-separated .bib names without extensions.
%% Example: \pxBibliography[abbrv]{references}. Cite normally with \cite{key}.
%% Native bibliography/biblatex commands remain available for manual workflows.
\NewDocumentCommand\pxBibliography{O{plain} m}{\__pxend_bibliography:nn {#1}{#2}}
\ProcessKeysOptions{pxEND}
\bool_set_true:N \l__pxgls_backend_locked_bool
%% Selecting a backend initializes it; ordinary use needs no separate setup command.
\tl_if_eq:NnTF \l__pxgls_backend_tl {noindex}
  {\makenoidxglossaries}{\makeglossaries}
\providecommand\pxDEFannexname{\appendixname}
\providecommand\pxDEFannexesname{\appendixname}
\providecommand\pxDEFglossaryname{\glossaryname}
\providecommand\pxDEFacronymname{Acronyms}
\AddToHook{begindocument/before}[pxEND]
  {\cs_if_exist:NT \crefname
    {\crefname{pxannex}{\pxDEFannexname}{\pxDEFannexesname}
     \Crefname{pxannex}{\pxDEFannexname}{\pxDEFannexesname}
     \crefname{pxmemannex}{\pxDEFannexname}{\pxDEFannexesname}
     \Crefname{pxmemannex}{\pxDEFannexname}{\pxDEFannexesname}}}
%% Print before glossaries checks usage and writes its final entry records.
\DeclareHookRule{enddocument}{pxEND}{before}{glossaries}
\AddToHook{enddocument}[pxEND]{
  \bool_if:NT \l__pxend_auto_bool {\__pxend_print:}
  \seq_if_empty:NF \g__pxann_pending_seq
    {\msg_warning:nn {pxEND}{pending-annexes}}
}
\endinput
