% P3CTeX optional daily Gantt diagrams.
% Public API is deliberately small; implementation lives in pxGNT.code.tex.
\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3,xparse,pgfgantt,xcolor,rotating}
\ProvidesExplPackage{pxGNT}{2026/10/22}{v0.1}{Daily Gantt charts for P3CTeX}

% Use the P3CTeX palette when present; remain usable standalone.
\@ifundefinedcolor{primaryColor}{\colorlet{primaryColor}{blue!60!black}}{}
\@ifundefinedcolor{secondaryColor}{\colorlet{secondaryColor}{cyan!35}}{}

\file_input:n {pxGNT.code.tex}

%% \pxGantt{start=dd/mm/yyyy,end=dd/mm/yyyy,days-per-block=28,...}
%% Initialize a daily chart; chart drawing is deferred to \pxGanttEnd.
\NewDocumentCommand\pxGantt{m}{\__pxgnt_begin:n{#1}}
%% \pxGanttItem{label}{dd/mm/yyyy}{dd/mm/yyyy}
%% Add a task. Each task is clipped to the currently displayed date block.
\NewDocumentCommand\pxGanttItem{mmm}{\__pxgnt_item:nnn{#1}{#2}{#3}}
%% \pxGanttEnd
%% Draw consecutive portrait blocks (or chart-only rotated floats when requested).
\NewDocumentCommand\pxGanttEnd{}{\__pxgnt_render:}
\endinput
