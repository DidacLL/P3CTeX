% P3CTeX — TFG metadata shared by PR and MEM documents.
\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{graphicx}
\ProvidesExplPackage{pxTFG}{2026/11/01}{v0.1}{Shared TFG metadata}

% \pxTFGsetup{tutor=..., pra=..., area=..., credits=..., keywords=..., licence=...}
% The ordinary P3CTeX/data and PAC/PR fields are unchanged.
\NewDocumentCommand{\pxTFGsetup}{+m}{\keys_set:nn {pxTFG} {#1}}

% Render the configured licence through the internal implementation.
\NewDocumentCommand\pxTFGlicencepage{}{\__pxtfg_licence_page:}

% Presentation and abstract implementations are separate from the public API.
\file_input:n {pxTFG.code.tex}
% Keep the class's existing cover/contents sequence; TFG supplies only its
% own preliminary content. Standalone licence use does not alter article.
\@ifclassloaded{P3CTeX}
  {
    \AddToHook{P3CTeX/before-toc}[pxTFG]
      {\bool_if:NT \l__pxtfg_auto_bool {\__pxtfg_frontmatter:}}
    \AddToHook{P3CTeX/after-toc}[pxTFG]
      {\bool_if:NT \l__pxtfg_auto_bool {\__pxtfg_auto_after_toc:}}
    % MEM lists belong after the abstracts, never between the card and TOC.
    \DeclareHookRule{P3CTeX/after-toc}{pxTFG}{before}{pxMEM}
  }
  {}

% \pxTFGabstract{CAT|ES|EN}{text}: store a language-specific abstract.
\NewDocumentCommand\pxTFGabstract{m +m}
  {\__pxtfg_abstract:nn {#1}{#2}}
% Explicit presentation is available with print=manual or independently.
\NewDocumentCommand\pxTFGworkcard{}{\__pxtfg_card:}
\NewDocumentCommand\pxTFGabstracts{}{\__pxtfg_abstracts:}
\NewDocumentCommand\pxTFGcoverdetails{}{\__pxtfg_cover_details:}
\NewDocumentCommand\pxTFGfrontmatter{}{\__pxtfg_frontmatter:}
\endinput
