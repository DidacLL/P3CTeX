% UOC TFG-specific semantics, independent of generic MEM support.
\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3,xparse}
\ProvidesExplPackage{pxTFG}{2026/10/22}{v0.3}{P3CTeX UOC TFG semantics}
%% TFG consumes P3CTeX's declared metadata, language and graphic interfaces.
\IfClassLoadedTF{P3CTeX}{}
  {\PackageError{pxTFG}{TFG requires the P3CTeX document class}
    {Select TFG in documentclass options.}}
\file_input:n {pxTFG.code.tex}

%% \pxTFGsetup{<key=value,...>}
%% Set TFG-only metadata: tutor, PRA, area, credits, keywords and licence. Shared information
%% (student, degree, project title, activity, date) stays in P3CTeX data keys.
%% Optional print=manual, workcard=false, abstracts=false or licence-page=false control placement/content.
%% Example: \pxTFGsetup{tutor={A. Tutor},credits=12,licence-page=false}
\NewDocumentCommand\pxTFGsetup{m}{\keys_set:nn {pxTFG} {#1}}
%% \pxTFGabstract{CAT|ES|EN}{<text>}
%% Store or replace one language-specific abstract for later printing.
%% This does not change the document language or immediately typeset it.
\NewDocumentCommand\pxTFGabstract{m +m}{\__pxtfg_abstract:nn {#1}{#2}}
%% \pxTFGworkcard
%% Typeset the UOC final-project information card using the current class
%% metadata and TFG-specific fields, with headings in the document language.
\NewDocumentCommand\pxTFGworkcard{}{\__pxtfg_card:}
%% \pxTFGabstracts
%% Print the abstracts already supplied by \pxTFGabstract, ordered CAT/ES/EN;
%% missing languages are omitted.
\NewDocumentCommand\pxTFGabstracts{}{\__pxtfg_abstracts:}
%% \pxTFGcoverdetails
%% Print TFG-specific cover metadata in an existing pxGDX text slot.
\NewDocumentCommand\pxTFGcoverdetails{}{\__pxtfg_cover_details:}
%% \pxTFGlicencepage
%% Print the configured licence page, if any.
\NewDocumentCommand\pxTFGlicencepage{}{\__pxtfg_licence_page:}
%% \pxTFGfrontmatter
%% Print only TFG-specific preliminary content: optional licence page,
%% information sheet with CAT summary, then ES/EN abstracts.
%% pxMEM is responsible for the complete memory structure and indexes.
\NewDocumentCommand\pxTFGfrontmatter{}{\__pxtfg_frontmatter:}

%% The class owns ordering; this extension supplies only TFG preliminary content.
\AddToHook{P3CTeX/before-toc}[pxTFG]{\bool_if:NT \l__pxtfg_auto_bool {\__pxtfg_frontmatter:\clearpage}}
\AddToHook{begindocument/end}[pxTFG]
  {\bool_if:NF \g__pxtfg_frontmatter_printed_bool
    {\bool_if:NT \l__pxtfg_auto_bool {\__pxtfg_frontmatter:\clearpage}}}
\endinput
