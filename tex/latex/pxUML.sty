\RequirePackage{pxPRP}
\RequirePackage{pgf-umlsd}
\ProvidesExplPackage{pxUML}{2025/02/21}{v0.2}{
	P3CTeX UML Graphics implementation based on top of pgf-umlcd and TikZ packages
}
