%% P3CTeX memory/report structure. Source rendering belongs to pxSRC;
%% terminology, references and annex placement belong to pxEND.
\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3,xparse,l3keys2e,pxSRC,pxEND,xcolor}
\ProvidesExplPackage{pxMEM}{2026/10/31}{0.3}{Memory structure and source composition}
\providecolor{primaryColor}{rgb}{0,0,.47}
\file_input:n {pxMEM.code.tex}
%% Package options use the same keys as \pxMEMsetup.
\ProcessKeysOptions{pxMEM}
%% \chapter[<contents title>]{<title>} / \chapter*{<title>}
%% Standard chapter syntax; existing report/book chapter commands are preserved.
\cs_if_exist:NF \chapter {\cs_new_eq:NN \chapter \__pxmem_chapter:}
%% Terminology headings follow the same chapter/TOC hierarchy as the memory.
\setglossarysection{chapter}
%% \pxMEMsetup{<options>}
%% #1 chapter-style, figures and tables; defaults use the P3CTeX palette and both lists.
%% Example: \pxMEMsetup{tables=false,chapter-style=\Large\bfseries\color{primaryColor}}
\NewDocumentCommand\pxMEMsetup{m}{\keys_set:nn {pxMEM}{#1}}
%% \pxMEMsource[<input options>]{<id>}{<file>}
%% Register any native, code or text source with its selection, labels and metadata.
%% #1 pxSRC defaults for this source; #2 reusable id; #3 path to the original file.
%% Example: \pxMEMsource[as=code,language=Java]{parser}{Parser.java}
\NewDocumentCommand\pxMEMsource{O{} m m}{\pxSRC_source:nnn {#1}{#2}{#3}}
%% \pxMEMinclude[<input options>]{<id>}{<region>}
%% #1 per-use formatting, caption, label-prefix, cite and terms; #2 source id;
%% #3 named marker region, or empty to include the complete registered source.
%% Native content keeps captions, labels, citations and glossary uses as ordinary TeX.
%% Example: \pxMEMinclude[label-prefix=pr1:]{PR1}{objectives}
\NewDocumentCommand\pxMEMinclude{O{} m m}{\__pxmem_include:nnn {#1}{#2}{#3}}
%% \pxMEMannex[<annex options>]{<title>}{<content>}
%% #1 label/heading options; #2 title; #3 deferred native content.
%% Queue at any point; the common end-matter facility places it automatically.
\NewDocumentCommand\pxMEMannex{O{} m +m}{\pxEND_add_annex:nnn {#1}{#2}{#3}}
%% \pxMEMpreliminaries{<content>}
%% Manual placement when automatic contents are disabled. #1 preliminary content.
%% The normal class contents command owns TOC formatting; indexes print only once.
\NewDocumentCommand\pxMEMpreliminaries{+m}
  {#1\bool_if:NF \g__pxmem_indexes_done_bool
    {\clearpage\cs_if_exist:NTF \PECTeXprintTOC
      {\PECTeXprintTOC}{\tableofcontents\clearpage}
     \__pxmem_indexes:}}
\AddToHook{P3CTeX/after-toc}[pxMEM]{\__pxmem_indexes:}
\endinput
