% P3CTeX calculation tools. Public API; implementation in pxCALC.code.tex.
\NeedsTeXFormat{LaTeX2e}
\RequirePackage{expl3,xparse,l3keys2e}
\RequirePackage{amsmath}
\RequirePackage{siunitx}
\ProvidesExplPackage{pxCALC}{2026/10/30}{0.1}{Reusable worked calculations}
\file_input:n {pxCALC.code.tex}
% All definitions and settings respect the current TeX group.
\NewDocumentCommand\pxCalcSetup{m}{\keys_set:nn {pxCALC}{#1}}
\NewDocumentCommand\pxDefVar{m m O{#1}}
  {\__pxcalc_var:nnn {#1}{#2}{#3}}
\NewDocumentCommand\pxSetVar{m m}
  {\__pxcalc_set:nn {#1}{#2}}
% Template slots use [name]; options include symbol, unit, prec and steps.
\NewDocumentCommand\pxDefFormula{m m O{}}
  {\__pxcalc_formula:nnn {#1}{#2}{#3}}
\NewDocumentCommand\pxSolve{O{} m}
  {\__pxcalc_solve:nn {#1}{#2}}
% Store an unrounded result in a caller-supplied command for later reuse.
\NewDocumentCommand\pxCalcStore{O{} m m}
  {\__pxcalc_store:nnN {#1}{#2}#3}
\NewDocumentCommand\pxCalc{O{} m}
  {\group_begin: \keys_set:nn {pxCALC}{#1}
   \__pxcalc_eval:nN {#2}\l__pxcalc_result_tl
   \__pxcalc_print_result: \group_end:}
\ProcessKeysOptions{pxCALC}
\endinput
